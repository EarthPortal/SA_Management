# Copy this file to .env and fill in the values. Never commit .env.
# Your API key for the portal (on EarthPortal: earthportal.eu, then your account page)
PORTAL_APIKEY=
# Snapshot to work on (folder earthportal_sa_audit/data/raw/<RUN_DATE>). Leave empty for today.
RUN_DATE=

# The portal to audit. Leave these lines commented to audit EarthPortal (the default values below).
# To audit another OntoPortal portal, see ADAPTING.md.
# PORTAL_NAME=EarthPortal
# PORTAL_API=https://data.earthportal.eu
# PORTAL_UI=https://earthportal.eu
# OFAIRE_API=https://services.earthportal.eu/ofaire/
# OFAIRE_PORTAL=earthportal
# PORTAL_EXAMPLE=OSO
