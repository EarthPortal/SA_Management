# ==================================================
# I. Common files
# ==================================================

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Editor and operating systems
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Secrets: the API key lives in .env, which must never be committed
.env
.env.*
!.env.example

# ==================================================
# II. Documentation (docs/)
# ==================================================

# latexmk writes everything to build/; keep only the compiled PDFs
docs/build/*
!docs/build/*.pdf

# ==================================================
# III. EarthPortal state-of-the-art audit (earthportal_sa_audit/)
# ==================================================

# Raw API answers: they contain contact e-mail addresses, and some records
# expose other portals' API keys in their pull URL
earthportal_sa_audit/data/raw/